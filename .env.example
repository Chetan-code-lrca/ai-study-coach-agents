# AI Study Coach environment configuration
# Copy this file to .env for local development.

# Vercel browser API (api/study.js). Keep this secret; never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional; defaults to openrouter/free, the free-model router.
OPENROUTER_MODEL=openrouter/free

# Gemini API key used by the separate Streamlit frontend and legacy services.
GOOGLE_API_KEY=your_gemini_api_key_here

# Firebase service-account credentials used by the legacy service layer.
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Optional Google Custom Search configuration used by the legacy resource recommender.
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Application configuration used by legacy services.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional Google Cloud Run deployment settings for legacy deployment code.
GCP_PROJECT_ID=your_project_id
GCP_REGION=us-central1
