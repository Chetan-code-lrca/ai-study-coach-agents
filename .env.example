# AI Study Coach environment configuration
# Copy only the settings needed by the application you are running.

# Maintained Streamlit frontend: OpenRouter chat-completions API.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Streamlit progress persistence. Uses DefaultAzureCredential
# (for example, a managed identity on a supported host). The target
# storage account must grant the identity the required Blob data role.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net

# Legacy Gemini service modules only; not used by the maintained Streamlit frontend.
GOOGLE_API_KEY=your_gemini_api_key_here

# Legacy Firebase service-account integration.
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Optional Google Custom Search configuration used by the legacy resource recommender.
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Application configuration used by legacy services.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional Google Cloud Run deployment settings for legacy deployment code.
GCP_PROJECT_ID=your_project_id
GCP_REGION=us-central1
