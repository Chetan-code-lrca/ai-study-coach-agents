# Active Streamlit edition
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Azure Blob persistence for Streamlit session summaries.
# Use a managed identity or a service principal with least-privilege access
# to the private studycoach-data container.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net

# Legacy prototype settings below are not used by the maintained Streamlit
# frontend or the Vercel browser edition. Do not add real credentials here.
GEMINI_API_KEY=
FIREBASE_CREDENTIALS_PATH=
GOOGLE_SEARCH_ENGINE_ID=
ENVIRONMENT=development
LOG_LEVEL=INFO
GCP_PROJECT_ID=
GCP_REGION=us-central1
