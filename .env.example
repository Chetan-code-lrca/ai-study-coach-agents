# Required for AI-powered actions in the Streamlit edition.
# Obtain a key from your OpenRouter account and keep the real value out of Git.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: enable persistent progress using Azure Blob Storage.
# The app uses DefaultAzureCredential (managed identity or Azure CLI login).
# Create a private container named "studycoach-data" and grant Blob Data Contributor.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
